# ─────────────────────────────────────────────────────────────
# Infinity Hoop Community — Environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. See README for where to get each.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Neon Postgres) ──
# Get from: https://console.neon.tech/ → create project → Connection Details
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Auth (Clerk) ──
# Get from: https://dashboard.clerk.com/ → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"
CLERK_WEBHOOK_SECRET="whsec_..."

# ── Payments (Stripe) ──
# Get from: https://dashboard.stripe.com/ → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Create 2 products in Stripe → copy price IDs here:
STRIPE_PRICE_MONTHLY="price_..."  # $39.99/month
STRIPE_PRICE_ANNUAL="price_..."   # $299/year

# ── Video (Mux) ──
# Get from: https://dashboard.mux.com/ → Settings → Access Tokens
MUX_TOKEN_ID="..."
MUX_TOKEN_SECRET="..."
MUX_WEBHOOK_SECRET="..."
MUX_SIGNING_KEY=""     # optional, for private playback
MUX_SIGNING_PRIVATE_KEY="" # optional

# ── Email (Resend) ──
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Infinity Hoop <hello@updates.infinityhoop.com>"

# ── File uploads (Vercel Blob) ──
# Get from: Vercel dashboard → Storage → Create Blob store
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ── Admin seed ──
# Email addresses that get admin role on signup (comma-separated)
ADMIN_EMAILS="you@infinityhoop.com"
